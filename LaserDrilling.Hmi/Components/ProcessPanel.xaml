<UserControl x:Class="LaserDrilling.Hmi.Components.ProcessPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:hc="https://handyorg.github.io/handycontrol">
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{DynamicResource Text.Machine.SetpointTitle}" FontWeight="SemiBold" FontSize="14"/>
   <TextBlock Text="{Binding Machine.ActiveRecipeName}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
   <StackPanel IsEnabled="{Binding Machine.CanEdit}">
    <TextBlock Text="{DynamicResource Text.Machine.SetPower}" FontSize="11" Margin="0,5,0,4"/>
    <hc:NumericUpDown Style="{StaticResource HmiNumber}" Minimum="0" Maximum="100" DecimalPlaces="1" Value="{Binding Setpoints.Power, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{DynamicResource Text.Machine.SetFrequency}" FontSize="11" Margin="0,5,0,4"/>
    <hc:NumericUpDown Style="{StaticResource HmiNumber}" Minimum="0.001" Maximum="1000" DecimalPlaces="3" Value="{Binding Setpoints.Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{DynamicResource Text.Machine.SetPulses}" FontSize="11" Margin="0,5,0,4"/>
    <hc:NumericUpDown Style="{StaticResource HmiNumber}" Minimum="1" Maximum="1000000" DecimalPlaces="0" Value="{Binding Setpoints.Pulses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{DynamicResource Text.Machine.SetCycles}" FontSize="11" Margin="0,5,0,4"/>
    <hc:NumericUpDown Style="{StaticResource HmiNumber}" Minimum="1" Maximum="9999" DecimalPlaces="0" Value="{Binding Setpoints.Cycles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Text.Machine.CycleHint}"/>
   </StackPanel>
   <Button Content="{DynamicResource Text.Machine.ApplySetpoints}" Command="{Binding ApplySetpointsCommand}" Style="{StaticResource PrimaryButton}" Height="32" FontSize="12" Margin="0,10,0,4"/>
   <Button Content="{DynamicResource Text.Machine.ReloadSetpoints}" Command="{Binding ReloadSetpointsCommand}" Style="{StaticResource SecondaryButton}" Height="28" FontSize="11"/>
   <TextBlock Text="{Binding SetpointHint}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,8"/>
   <Separator Margin="0,6,0,12"/>
   <TextBlock Text="{DynamicResource Text.Machine.ActualTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
   <TextBlock Text="{DynamicResource Text.Machine.LivePower}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.CurrentPowerPercent, StringFormat={}{0:F1} %}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <TextBlock Text="{DynamicResource Text.Machine.ActualFrequency}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.ActualFrequencyKhz, StringFormat={}{0:F3}}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <TextBlock Text="{Binding Machine.CycleCountLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.Cycles.Display}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <TextBlock Text="{Binding Machine.CountLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.ProgressText}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <TextBlock Text="{DynamicResource Text.Machine.Active}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.ActiveHole}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <TextBlock Text="{DynamicResource Text.Machine.Elapsed}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
   <TextBlock Text="{Binding Machine.ElapsedText}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
   <ProgressBar Style="{x:Null}" Foreground="{DynamicResource AccentBrush}" Value="{Binding Machine.Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
 </Border>
</UserControl>
