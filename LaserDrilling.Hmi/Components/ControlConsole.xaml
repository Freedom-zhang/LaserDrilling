<UserControl
    x:Class="LaserDrilling.Hmi.Components.ControlConsole"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LaserDrilling.Hmi.Views"
    xmlns:controls="clr-namespace:LaserDrilling.Hmi.Controls">
    <UserControl.Resources>
        <Style
            x:Key="Tile"
            BasedOn="{StaticResource SecondaryButton}"
            TargetType="Button">
            <Setter Property="Height" Value="55" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="#344957" />
            <Setter Property="BorderBrush" Value="#6A7C89" />
            <Setter Property="Foreground" Value="#E8F0F5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Border
        Padding="8"
        Background="{DynamicResource ConsoleBackgroundBrush}"
        BorderThickness="0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <UniformGrid Margin="3,0,3,5" Columns="2">
                    <Button
                        Height="80"
                        Command="{Binding DryRunCommand}"
                        Content="{DynamicResource Text.Machine.DryRun}"
                        Style="{StaticResource Tile}" />
                    <Button
                        Height="80"
                        Command="{Binding PauseCommand}"
                        Content="{Binding PauseCaption}"
                        Style="{StaticResource Tile}" />
                </UniformGrid>
                <UniformGrid Margin="3,0,3,5" Columns="2">
                    <Button
                        Height="80"
                        Background="#167447"
                        Command="{Binding StartCommand}"
                        Content="{DynamicResource Text.Machine.Start}"
                        Style="{StaticResource Tile}" />
                    <Button
                        Height="80"
                        Background="#A92F37"
                        Command="{Binding StopCommand}"
                        Content="{DynamicResource Text.Machine.Stop}"
                        Style="{StaticResource Tile}" />
                </UniformGrid>
            </StackPanel>
            <Viewbox
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Stretch="Uniform"
                StretchDirection="DownOnly">
                <StackPanel Width="250">
                    <TextBlock
                        Margin="4,1,0,6"
                        FontWeight="SemiBold"
                        Foreground="#E8F0F5"
                        Text="{DynamicResource Text.Machine.Control}" />
                    <Border
                        Margin="3,0,3,5"
                        Padding="10,6"
                        Background="#101D27">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock
                                    Width="24"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#FFBF4D"
                                    Text="X" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#F1F6F8"
                                    Text="{Binding Machine.X, StringFormat={}{0:F3} mm}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock
                                    Width="24"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#FFBF4D"
                                    Text="Y" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#F1F6F8"
                                    Text="{Binding Machine.Y, StringFormat={}{0:F3} mm}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock
                                    Width="24"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#FFBF4D"
                                    Text="Z" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    Foreground="#F1F6F8"
                                    Text="{Binding Machine.Z, StringFormat={}{0:F3} mm}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ShutterCommand}" ToolTip="{Binding ShutterHint}" ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Machine.ShutterOpen}" Value="True">
                                        <Setter Property="Background" Value="#855B12" />
                                        <Setter Property="BorderBrush" Value="#FFBF4D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                Data="M3,3 L21,21 M12,2 A10,10 0 1 1 11.9,2 M7,12 L17,12"
                                Stretch="Uniform"
                                Stroke="#FFBF4D"
                                StrokeThickness="1.8" />
                            <TextBlock
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="{Binding ShutterCaption}" />
                        </StackPanel>
                    </Button>
                    <UniformGrid Columns="2">
                        <Button Command="{Binding RedLightCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.RedLightOn}" Value="True">
                                            <Setter Property="Background" Value="#855B12" />
                                            <Setter Property="BorderBrush" Value="#FFBF4D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M12,1 L12,23 M1,12 L23,12 M12,5 A7,7 0 1 1 11.9,5"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{DynamicResource Text.Machine.RedLight}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EmitCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.LaserOn}" Value="True">
                                            <Setter Property="Background" Value="#855B12" />
                                            <Setter Property="BorderBrush" Value="#FFBF4D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12 M5,5 L8,8 M16,16 L19,19 M5,19 L8,16 M16,8 L19,5 M12,9 A3,3 0 1 1 11.9,9"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{DynamicResource Text.Machine.Emit}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FollowCommand}" ToolTip="{Binding FollowHint}" ToolTipService.ShowOnDisabled="True">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.FollowEnabled}" Value="True">
                                            <Setter Property="Background" Value="#855B12" />
                                            <Setter Property="BorderBrush" Value="#FFBF4D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M5,3 L13,3 13,12 5,12 Z M9,14 L9,22 M5,18 L9,22 13,18 M18,3 L18,15 M15,6 L18,3 21,6"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{Binding FollowCaption}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AirCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.AirOn}" Value="True">
                                            <Setter Property="Background" Value="#855B12" />
                                            <Setter Property="BorderBrush" Value="#FFBF4D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M5,2 L19,2 15,8 9,8 Z M12,10 L12,22 M9,10 L5,21 M15,10 L19,21"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{DynamicResource Text.Machine.Air}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding HomeCommand}" Style="{StaticResource Tile}">
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M2,12 L12,3 22,12 M6,10 L6,21 18,21 18,10"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{DynamicResource Text.Machine.Home}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FrameCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Tile}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.IsFraming}" Value="True">
                                            <Setter Property="Background" Value="#855B12" />
                                            <Setter Property="BorderBrush" Value="#FFBF4D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Path
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Data="M8,3 L3,3 3,9 M16,3 L21,3 21,9 M3,15 L3,21 9,21 M15,21 L21,21 21,15 M8,12 L16,12 M13,9 L16,12 13,15"
                                    Stretch="Uniform"
                                    Stroke="#FFBF4D"
                                    StrokeThickness="1.8" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{DynamicResource Text.Machine.Frame}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <!-- 每条提示预留三行高度，避免点动时状态文字变化引起控制区缩放。 -->
                    <StackPanel Margin="5,5,5,2">
                        <TextBlock Text="{Binding ShutterHint}" Height="36" LineHeight="12" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShutterHint}" TextWrapping="Wrap" FontSize="10" Foreground="#B7CAD7" />
                        <TextBlock Text="{Binding FollowHint}" Height="36" LineHeight="12" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding FollowHint}" TextWrapping="Wrap" FontSize="10" Foreground="#B7CAD7" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <controls:JogWheel
                            Width="146"
                            Height="146"
                            IsEnabled="{Binding Machine.CanJog}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button
                                Height="55"
                                Content="Z ↑"
                                FontSize="21"
                                IsEnabled="{Binding Machine.CanZJog}"
                                IsEnabledChanged="ZDisabled"
                                LostMouseCapture="ZLeave"
                                MouseLeave="ZLeave"
                                PreviewKeyDown="ZKey"
                                PreviewMouseLeftButtonDown="ZDown"
                                PreviewMouseLeftButtonUp="ZUp"
                                Style="{StaticResource Tile}"
                                Tag="+" />
                            <Button
                                Height="55"
                                Content="Z ↓"
                                FontSize="21"
                                IsEnabled="{Binding Machine.CanZJog}"
                                IsEnabledChanged="ZDisabled"
                                LostMouseCapture="ZLeave"
                                MouseLeave="ZLeave"
                                PreviewKeyDown="ZKey"
                                PreviewMouseLeftButtonDown="ZDown"
                                PreviewMouseLeftButtonUp="ZUp"
                                Style="{StaticResource Tile}"
                                Tag="-" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Margin="5,0,5,4"
                        FontSize="10"
                        Foreground="#B7CAD7"
                        Text="{DynamicResource Text.Machine.ConsoleHint}"
                        TextWrapping="Wrap" />
                    <DockPanel Margin="5,5">
                        <TextBlock
                            Width="180"
                            FontSize="11"
                            Foreground="#D8E5EF"
                            Text="{DynamicResource Text.Machine.Speed}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            Foreground="#FFBF4D"
                            Text="{Binding Machine.JogOverride, StringFormat={}{0:0}%}" />
                    </DockPanel>
                    <Slider
                        Margin="7,0,7,8"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="10"
                        TickFrequency="10"
                        Value="{Binding Machine.JogOverride}" />
                    <DockPanel Margin="5,0,5,8">
                        <TextBlock
                            Width="180"
                            FontSize="11"
                            Foreground="#D8E5EF"
                            Text="{DynamicResource Text.Machine.LivePower}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            Foreground="#FFBF4D"
                            Text="{Binding Machine.CurrentPowerPercent, StringFormat={}{0:F1} %}" />
                    </DockPanel>
                </StackPanel>
            </Viewbox>
        </DockPanel>
    </Border>
</UserControl>