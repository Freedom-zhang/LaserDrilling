<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:views="clr-namespace:LaserDrilling.Hmi.Views"
    Margin="16">
    <Grid.Resources>
        <Style x:Key="RecipeItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style
            x:Key="Small"
            BasedOn="{StaticResource SecondaryButton}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
        <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{DynamicResource Text.Machine.ActiveRecipe}" />
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentBrush}"
                Text="{Binding ActiveName}" />
        </StackPanel>
        <StackPanel>
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{DynamicResource Text.Machine.NavRecipes}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{DynamicResource Text.Machine.RecipeFileHint}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top">
                <Button
                    Margin="0,0,0,8"
                    Command="{Binding NewCommand}"
                    Content="{DynamicResource Text.Machine.NewRecipe}"
                    Style="{StaticResource Small}" />
                <Button
                    Margin="0,0,0,8"
                    Command="{Binding ReloadCommand}"
                    Content="{DynamicResource Text.Machine.ReloadRecipes}"
                    Style="{StaticResource Small}" />
            </StackPanel>
            <ListBox
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                Foreground="{DynamicResource InkBrush}"
                IsEnabled="{Binding CanSelect}"
                ItemContainerStyle="{StaticResource RecipeItem}"
                ItemsSource="{Binding Recipes}"
                SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,8">
                            <TextBlock
                                MaxWidth="160"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="11" Text="{Binding Material}" />
                                <TextBlock FontSize="11" Text="{Binding ThicknessMm, StringFormat={} · {0} mm}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border
                    Padding="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="3,1,1,1">
                    <UniformGrid Columns="2" IsEnabled="{Binding CanEdit}">
                        <StackPanel Margin="6,4">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource InkBrush}"
                                Text="{DynamicResource Text.Machine.RecipeName}"
                                TextWrapping="Wrap" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="6,4">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource InkBrush}"
                                Text="{DynamicResource Text.Machine.RecipeMaterial}"
                                TextWrapping="Wrap" />
                            <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="6,4">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource InkBrush}"
                                Text="{DynamicResource Text.Machine.Thickness}"
                                TextWrapping="Wrap" />
                            <hc:NumericUpDown
                                DecimalPlaces="2"
                                Increment="0.1"
                                Maximum="100"
                                Minimum="0.01"
                                Style="{StaticResource HmiNumber}"
                                Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                        </StackPanel>
                        <StackPanel Margin="6,4">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource InkBrush}"
                                Text="{DynamicResource Text.Machine.Nozzle}"
                                TextWrapping="Wrap" />
                            <TextBox Text="{Binding Nozzle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <Border
                    Margin="0,8,0,8"
                    Padding="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="3,1,1,1">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <UniformGrid Columns="3">
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Machine.PeakPower}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="1"
                                    Increment="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Power, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Frequency}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="3"
                                    Increment="1"
                                    Maximum="1000"
                                    Minimum="0.001"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Pulses}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="0"
                                    Increment="1"
                                    Maximum="1000000"
                                    Minimum="1"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Pulses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Machine.Dwell}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="0"
                                    Increment="100"
                                    Maximum="60000"
                                    Minimum="100"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Dwell, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Machine.Pressure}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.1"
                                    Maximum="30"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Pressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="6,4">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource InkBrush}"
                                    Text="{DynamicResource Text.Machine.Focus}"
                                    TextWrapping="Wrap" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.1"
                                    Maximum="100"
                                    Minimum="-100"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Focus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel Margin="6,8">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Machine.GasType}" />
                            <ComboBox
                                Width="140"
                                Height="30"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding Gases}"
                                SelectedItem="{Binding Gas}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Text.Machine.CurveTitle}" />
                        <TextBlock
                            Margin="0,6,0,10"
                            FontSize="11"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="{DynamicResource Text.Machine.CurveHint}"
                            TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurveWarning}" Foreground="#BD6500" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="175" />
                            </Grid.ColumnDefinitions>
                            <views:PowerCurveEditor
                                Height="220"
                                Margin="0,0,12,0"
                                Revision="{Binding Revision}" />
                            <ListBox
                                Grid.Column="1"
                                Height="220"
                                Background="{DynamicResource InputBrush}"
                                Foreground="{DynamicResource InkBrush}"
                                ItemContainerStyle="{StaticResource RecipeItem}"
                                ItemsSource="{Binding Points}"
                                SelectedItem="{Binding SelectedPoint}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5" Orientation="Horizontal">
                                            <TextBlock Width="65" Text="{Binding Progress, StringFormat={}{0:0.##}%}" />
                                            <TextBlock Foreground="{DynamicResource MutedBrush}" Text=" → " />
                                            <TextBlock Width="55" Text="{Binding PowerPercent, StringFormat={}{0:0.##}%}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
                            <StackPanel Width="115" Margin="0,0,8,0">
                                <TextBlock FontSize="11" Text="{DynamicResource Text.Machine.PointProgress}" />
                                <hc:NumericUpDown
                                    Margin="0,4,0,0"
                                    DecimalPlaces="2"
                                    Increment="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding PointProgress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Width="115" Margin="0,0,8,0">
                                <TextBlock FontSize="11" Text="{DynamicResource Text.Machine.PointPower}" />
                                <hc:NumericUpDown
                                    Margin="0,4,0,0"
                                    DecimalPlaces="2"
                                    Increment="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding PointPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <Button
                                Margin="0,16,6,0"
                                Command="{Binding UpdatePointCommand}"
                                Content="{DynamicResource Text.Machine.UpdatePoint}"
                                Style="{StaticResource Small}" />
                            <Button
                                Margin="0,16,6,0"
                                Command="{Binding AddPointCommand}"
                                Content="{DynamicResource Text.Machine.NewPoint}"
                                Style="{StaticResource Small}" />
                            <Button
                                Margin="0,16,0,0"
                                Command="{Binding DeletePointCommand}"
                                Content="{DynamicResource Text.Machine.DeletePoint}"
                                Style="{StaticResource Small}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock
                    Margin="0,8"
                    FontSize="11"
                    Foreground="{DynamicResource MutedBrush}"
                    Text="{DynamicResource Text.Machine.RecipeDemo}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
        <TextBlock
            Foreground="{DynamicResource AccentBrush}"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
        <DockPanel Margin="0,8,0,0">
            <Button
                Height="36"
                Margin="8,0,0,0"
                Command="{Binding ApplyCommand}"
                Content="{DynamicResource Text.Machine.ApplyRecipe}"
                DockPanel.Dock="Right"
                Style="{StaticResource PrimaryButton}" />
            <Button
                Height="36"
                Margin="8,0,0,0"
                Command="{Binding SaveCommand}"
                Content="{DynamicResource Text.Machine.SaveRecipe}"
                DockPanel.Dock="Right"
                Style="{StaticResource Small}" />
            <Button
                Height="36"
                Margin="8,0,0,0"
                Command="{Binding DiscardCommand}"
                Content="{DynamicResource Text.Machine.Discard}"
                DockPanel.Dock="Right"
                Style="{StaticResource Small}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{Binding EditStatus}" />
        </DockPanel>
        <TextBlock
            Margin="0,8,0,0"
            FontSize="10"
            Foreground="{DynamicResource MutedBrush}"
            Text="{Binding DirectoryPath}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            FontSize="11"
            Foreground="{DynamicResource ErrorBrush}"
            Text="{Binding LoadWarning}"
            TextWrapping="Wrap" />
    </StackPanel>
</Grid>
