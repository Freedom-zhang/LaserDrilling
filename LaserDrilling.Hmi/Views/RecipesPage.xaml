<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views" Margin="16">
 <Grid.Resources>
 <Style x:Key="RecipeItem" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/></Trigger></Style.Triggers></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{DynamicResource Text.Machine.ActiveRecipe}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding ActiveName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Text.Machine.NavRecipes}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text.Machine.RecipeFileHint}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <DockPanel Margin="0,0,12,0"><StackPanel DockPanel.Dock="Top"><Button Content="{DynamicResource Text.Machine.NewRecipe}" Command="{Binding NewCommand}" Style="{StaticResource Small}" Margin="0,0,0,8"/><Button Content="{DynamicResource Text.Machine.ReloadRecipes}" Command="{Binding ReloadCommand}" Style="{StaticResource Small}" Margin="0,0,0,8"/></StackPanel>
 <ListBox ItemContainerStyle="{StaticResource RecipeItem}" ItemsSource="{Binding Recipes}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelect}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Material}" FontSize="11"/><TextBlock Text="{Binding ThicknessMm, StringFormat={} · {0} mm}" FontSize="11"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6"><UniformGrid Columns="4" IsEnabled="{Binding CanEdit}"><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.RecipeName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.RecipeMaterial}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.Thickness}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.Nozzle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Nozzle, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid></Border>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6" Margin="0,8,0,8"><StackPanel IsEnabled="{Binding CanEdit}"><UniformGrid Columns="3"><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.PeakPower}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Power, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Frequency}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Pulses}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Pulses, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.Dwell}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Dwell, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.Pressure}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Pressure, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="6,4"><TextBlock Text="{DynamicResource Text.Machine.Focus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Focus, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid><DockPanel Margin="6,8"><TextBlock Text="{DynamicResource Text.Machine.GasType}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding Gases}" SelectedItem="{Binding Gas}" Width="140" HorizontalAlignment="Left" Height="30"/></DockPanel></StackPanel></Border>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12"><StackPanel>
 <TextBlock Text="{DynamicResource Text.Machine.CurveTitle}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{DynamicResource Text.Machine.CurveHint}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
 <views:PowerCurveEditor Height="220" Revision="{Binding Revision}" Margin="0,0,12,0"/>
 <ListBox ItemContainerStyle="{StaticResource RecipeItem}" Grid.Column="1" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" Height="220" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InkBrush}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5"><TextBlock Text="{Binding Progress, StringFormat={}{0:0.##}%}" Width="65"/><TextBlock Text=" → " Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PowerPercent, StringFormat={}{0:0.##}%}" Width="55"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 </Grid>
 <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanEdit}"><StackPanel Width="115" Margin="0,0,8,0"><TextBlock Text="{DynamicResource Text.Machine.PointProgress}" FontSize="11"/><TextBox Text="{Binding PointProgress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel><StackPanel Width="115" Margin="0,0,8,0"><TextBlock Text="{DynamicResource Text.Machine.PointPower}" FontSize="11"/><TextBox Text="{Binding PointPower, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
 <Button Content="{DynamicResource Text.Machine.UpdatePoint}" Command="{Binding UpdatePointCommand}" Style="{StaticResource Small}" Margin="0,16,6,0"/><Button Content="{DynamicResource Text.Machine.NewPoint}" Command="{Binding AddPointCommand}" Style="{StaticResource Small}" Margin="0,16,6,0"/><Button Content="{DynamicResource Text.Machine.DeletePoint}" Command="{Binding DeletePointCommand}" Style="{StaticResource Small}" Margin="0,16,0,0"/>
 </WrapPanel></StackPanel></Border>
 <TextBlock Text="{DynamicResource Text.Machine.RecipeDemo}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
 </StackPanel></ScrollViewer></Grid>
 <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/><DockPanel Margin="0,8,0,0">
 <Button DockPanel.Dock="Right" Content="{DynamicResource Text.Machine.ApplyRecipe}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Height="36" Margin="8,0,0,0"/>
 <Button DockPanel.Dock="Right" Content="{DynamicResource Text.Machine.SaveRecipe}" Command="{Binding SaveCommand}" Style="{StaticResource Small}" Height="36" Margin="8,0,0,0"/>
 <Button DockPanel.Dock="Right" Content="{DynamicResource Text.Machine.Discard}" Command="{Binding DiscardCommand}" Style="{StaticResource Small}" Height="36" Margin="8,0,0,0"/>
 <TextBlock Text="{Binding EditStatus}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
 <TextBlock Text="{Binding DirectoryPath}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
 <TextBlock Text="{Binding LoadWarning}" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
 </StackPanel>
</Grid>
