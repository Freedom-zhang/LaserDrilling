<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LaserDrilling.Hmi.Views"
    Margin="24">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock
        Margin="0,0,0,20"
        FontSize="24"
        FontWeight="SemiBold"
        Text="{DynamicResource Text.Machine.NavSettings}" />
    <Border
        Grid.Row="1"
        Padding="20"
        Background="{DynamicResource SurfaceBrush}">
        <DockPanel>
            <Button
                Margin="12,0,0,0"
                Command="{Binding ThemeCommand}"
                Content="{DynamicResource Text.ThemeChoice}"
                DockPanel.Dock="Right"
                Style="{StaticResource SecondaryButton}" />
            <Button
                Command="{Binding LanguageCommand}"
                Content="中文 / EN"
                DockPanel.Dock="Right"
                Style="{StaticResource SecondaryButton}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                Text="{DynamicResource Text.Machine.Appearance}" />
        </DockPanel>
    </Border>
    <views:AccessPanel Grid.Row="2" DataContext="{Binding Panel}" />
</Grid>
