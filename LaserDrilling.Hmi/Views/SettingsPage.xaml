<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views" Margin="24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <TextBlock Text="{DynamicResource Text.Machine.NavSettings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
 <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="20"><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Text.ThemeChoice}" Command="{Binding ThemeCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/><Button DockPanel.Dock="Right" Content="中文 / EN" Command="{Binding LanguageCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{DynamicResource Text.Machine.Appearance}" VerticalAlignment="Center" FontSize="18"/></DockPanel></Border>
 <views:AccessPanel Grid.Row="2" DataContext="{Binding Panel}"/>
</Grid>
