<UserControl
    x:Class="LaserDrilling.Hmi.Views.SplashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AutomationProperties.Name="公司启动页"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid Background="{DynamicResource PageBrush}">
        <Border
            Height="5"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentBrush}" />
        <Path
            Width="360"
            Height="360"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Data="M0,160 L160,0 M0,260 L260,0 M0,360 L360,0"
            IsHitTestVisible="False"
            Stroke="{DynamicResource LineBrush}"
            StrokeThickness="1" />
        <Path
            Width="360"
            Height="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Data="M0,160 L160,0 M0,260 L260,0 M0,360 L360,0"
            IsHitTestVisible="False"
            Stroke="{DynamicResource LineBrush}"
            StrokeThickness="1" />
        <TextBlock
            Margin="38,30"
            VerticalAlignment="Top"
            FontSize="11"
            Foreground="{DynamicResource MutedBrush}"
            Text="LASER PROCESSING / HMI" />
        <StackPanel
            Margin="0,0,0,18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image
                Width="116"
                Height="116"
                Margin="0,0,0,22"
                Source="{StaticResource CompanyLogo}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="38"
                FontWeight="SemiBold"
                Text="{Binding Brand.CompanyName}" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontFamily="Consolas"
                FontSize="16"
                Foreground="{DynamicResource MutedBrush}"
                Text="{Binding Brand.CompanyEnglishName}" />
            <Border
                Width="48"
                Height="1"
                Margin="0,28,0,22"
                Background="#A8BBC7" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="17"
                Text="{DynamicResource Text.Product}" />
            <hc:LoadingLine
                Width="210"
                Height="8"
                Margin="0,30,0,15"
                Foreground="{DynamicResource AccentBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource MutedBrush}"
                Text="{Binding Status}" />
        </StackPanel>
        <Grid Margin="38,0,38,26" VerticalAlignment="Bottom">
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{DynamicResource Text.Tagline}" />
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{DynamicResource Text.DemoVersion}" />
        </Grid>
    </Grid>
</UserControl>
