<UserControl
    x:Class="LaserDrilling.Hmi.Views.DrillingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:views="clr-namespace:LaserDrilling.Hmi.Views"
    xmlns:components="clr-namespace:LaserDrilling.Hmi.Components"
    xmlns:controls="clr-namespace:LaserDrilling.Hmi.Controls">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MachineStateLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Machine.State}" Value="Fault">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource SecondaryButton}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="27" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <Border
                Margin="0,0,2,0"
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource Text.Machine.Job}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="DEMO_MICRO_001" />
                        <TextBlock
                            Margin="0,8,0,5"
                            FontSize="12"
                            Text="{DynamicResource Text.Machine.Sample}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="{DynamicResource Text.Machine.Material}" />
                        <Separator Margin="0,14" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource Text.Machine.HoleList}" />
                        <DataGrid
                            Height="215"
                            CanUserSortColumns="False"
                            ItemsSource="{Binding Machine.Holes}"
                            SelectedItem="{Binding Selected}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="35"
                                    Binding="{Binding Number}"
                                    Header="#" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding X, StringFormat=F2}"
                                    Header="X" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Y, StringFormat=F2}"
                                    Header="Y" />
                                <DataGridCheckBoxColumn
                                    Width="30"
                                    Binding="{Binding Done}"
                                    Header="✓" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Separator Margin="0,12" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource Text.Machine.HoleEdit}" />
                        <UniformGrid Columns="2" IsEnabled="{Binding Machine.CanEdit}">
                            <StackPanel Margin="0,0,5,8">
                                <TextBlock Margin="0,0,0,4" Text="X / mm" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.1"
                                    Maximum="100"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding HoleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="5,0,0,8">
                                <TextBlock Margin="0,0,0,4" Text="Y / mm" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.1"
                                    Maximum="80"
                                    Minimum="0"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding HoleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Margin="0,0,0,4" Text="{DynamicResource Text.Machine.Diameter}" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.01"
                                    Maximum="5"
                                    Minimum="0.01"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Diameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Margin="0,0,0,4" Text="{DynamicResource Text.Machine.Depth}" />
                                <hc:NumericUpDown
                                    DecimalPlaces="2"
                                    Increment="0.1"
                                    Maximum="10"
                                    Minimum="0.01"
                                    Style="{StaticResource HmiNumber}"
                                    Value="{Binding Depth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Margin="0,8,0,0" Columns="3">
                            <Button
                                Command="{Binding AddCommand}"
                                Content="{DynamicResource Text.Machine.Add}"
                                Style="{StaticResource ToolButton}" />
                            <Button
                                Command="{Binding ApplyCommand}"
                                Content="{DynamicResource Text.Machine.Apply}"
                                Style="{StaticResource ToolButton}" />
                            <Button
                                Command="{Binding DeleteCommand}"
                                Content="{DynamicResource Text.Machine.Delete}"
                                Style="{StaticResource ToolButton}" />
                        </UniformGrid>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="{Binding Notice}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                    
                    
                </Grid.RowDefinitions>
                <Border
                    Padding="10,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1,1,1,0">
                    <DockPanel>
                        <Button
                            Click="OnFit"
                            Content="{DynamicResource Text.Machine.Fit}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ToolButton}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Text.Machine.Workspace}" />
                    </DockPanel>
                </Border>
                <controls:DrillingViewport
                    x:Name="Viewport"
                    Grid.Row="1"
                    Revision="{Binding Machine.Revision}" />
                <Border
                    Grid.Row="2"
                    Padding="10,6"
                    Background="#1D3444">
                    <TextBlock
                        FontSize="10"
                        Foreground="#AFC4D0"
                        Text="{DynamicResource Text.Machine.ViewportHint}" />
                </Border>
            </Grid>
            <components:ProcessPanel Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
