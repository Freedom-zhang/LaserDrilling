<UserControl x:Class="LaserDrilling.Hmi.Views.DrillingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views">
 <UserControl.Resources>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="5,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="MachineStateLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/><Style.Triggers><DataTrigger Binding="{Binding Machine.State}" Value="Fault"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="2"/></Style>
  <Style x:Key="PanelTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="27"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/></Style>
 </UserControl.Resources>
 <Grid Margin="0">
  
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,2,0" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{DynamicResource Text.Machine.Job}" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="DEMO_MICRO_001" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{DynamicResource Text.Machine.Sample}" FontSize="12" Margin="0,8,0,5"/>
     <TextBlock Text="{DynamicResource Text.Machine.Material}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
     <Separator Margin="0,14"/>
     <TextBlock Text="{DynamicResource Text.Machine.HoleList}" Style="{StaticResource PanelTitle}"/>
     <DataGrid ItemsSource="{Binding Machine.Holes}" SelectedItem="{Binding Selected}" SelectionMode="Single" Height="215" CanUserSortColumns="False">
      <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/><DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F2}" Width="*"/><DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F2}" Width="*"/><DataGridCheckBoxColumn Header="✓" Binding="{Binding Done}" Width="30"/></DataGrid.Columns>
     </DataGrid>
     <Separator Margin="0,12"/>
     <TextBlock Text="{DynamicResource Text.Machine.HoleEdit}" Style="{StaticResource PanelTitle}"/>
     <UniformGrid Columns="2" IsEnabled="{Binding Machine.CanEdit}">
      <StackPanel Margin="0,0,5,8"><TextBlock Text="X / mm" Margin="0,0,0,4"/><hc:NumericUpDown Style="{StaticResource HmiNumber}" Value="{Binding HoleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" Minimum="0" Maximum="100" Increment="0.1" DecimalPlaces="2"/></StackPanel>
      <StackPanel Margin="5,0,0,8"><TextBlock Text="Y / mm" Margin="0,0,0,4"/><hc:NumericUpDown Style="{StaticResource HmiNumber}" Value="{Binding HoleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" Minimum="0" Maximum="80" Increment="0.1" DecimalPlaces="2"/></StackPanel>
      <StackPanel Margin="0,0,5,0"><TextBlock Text="{DynamicResource Text.Machine.Diameter}" Margin="0,0,0,4"/><hc:NumericUpDown Style="{StaticResource HmiNumber}" Value="{Binding Diameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" Minimum="0.01" Maximum="5" Increment="0.01" DecimalPlaces="2"/></StackPanel>
      <StackPanel Margin="5,0,0,0"><TextBlock Text="{DynamicResource Text.Machine.Depth}" Margin="0,0,0,4"/><hc:NumericUpDown Style="{StaticResource HmiNumber}" Value="{Binding Depth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" Minimum="0.01" Maximum="10" Increment="0.1" DecimalPlaces="2"/></StackPanel>
     </UniformGrid>
     <UniformGrid Columns="3" Margin="0,8,0,0">
      <Button Content="{DynamicResource Text.Machine.Add}" Command="{Binding AddCommand}" Style="{StaticResource ToolButton}"/>
      <Button Content="{DynamicResource Text.Machine.Apply}" Command="{Binding ApplyCommand}" Style="{StaticResource ToolButton}"/>
      <Button Content="{DynamicResource Text.Machine.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}"/>
     </UniformGrid>
     <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Margin="0,0,2,0">
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="58"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0" Padding="10,0">
     <DockPanel><Button Content="{DynamicResource Text.Machine.Fit}" Click="OnFit" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"/><TextBlock Text="{DynamicResource Text.Machine.Workspace}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <views:DrillingViewport x:Name="Viewport" Grid.Row="1" Revision="{Binding Machine.Revision}"/>
    <Border Grid.Row="2" Background="#1D3444" Padding="10,6"><TextBlock Text="{DynamicResource Text.Machine.ViewportHint}" Foreground="#AFC4D0" FontSize="10"/></Border>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,1">
     <StackPanel><TextBlock Text="{Binding Machine.ActiveRecipeName}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Machine.RecipeText}" FontFamily="Consolas" FontSize="17" Margin="0,5,0,0"/></StackPanel>
    </Border>
    <Grid Grid.Row="4" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
     <StackPanel Margin="12,6"><DockPanel><TextBlock Text="{Binding Machine.ProgressText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="17"/><TextBlock Text="{Binding Machine.CountLabel}" FontSize="11" VerticalAlignment="Center"/></DockPanel><ProgressBar Style="{x:Null}" Value="{Binding Machine.Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="10,6"><TextBlock Text="{DynamicResource Text.Machine.Active}" FontSize="11"/><TextBlock Text="{Binding Machine.ActiveHole}" FontFamily="Consolas" FontSize="20" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="10,6"><TextBlock Text="{DynamicResource Text.Machine.Elapsed}" FontSize="11"/><TextBlock Text="{Binding Machine.ElapsedText}" FontFamily="Consolas" FontSize="20" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
