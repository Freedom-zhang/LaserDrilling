<UserControl x:Class="LaserDrilling.Hmi.Views.ControlConsole" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views">
<UserControl.Resources><Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="55"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/><Setter Property="Background" Value="#344957"/><Setter Property="BorderBrush" Value="#6A7C89"/><Setter Property="Foreground" Value="#E8F0F5"/><Setter Property="FontSize" Value="12"/></Style></UserControl.Resources>
<Border Background="#233440" BorderBrush="#6A7C89" BorderThickness="1,0,0,0" Padding="8"><DockPanel>
<StackPanel DockPanel.Dock="Bottom"><UniformGrid Columns="2"><Button Content="{DynamicResource Text.Machine.DryRun}" Command="{Binding DryRunCommand}" Style="{StaticResource Tile}" Height="37"/><Button Content="{Binding PauseCaption}" Command="{Binding PauseCommand}" Style="{StaticResource Tile}" Height="37"/></UniformGrid><UniformGrid Columns="2"><Button Content="{DynamicResource Text.Machine.Start}" Command="{Binding StartCommand}" Style="{StaticResource Tile}" Background="#167447" Height="44"/><Button Content="{DynamicResource Text.Machine.Stop}" Command="{Binding StopCommand}" Style="{StaticResource Tile}" Background="#A92F37" Height="44"/></UniformGrid><Button Content="{DynamicResource Text.Machine.Emergency}" Command="{Binding EmergencyCommand}" Style="{StaticResource Tile}" Background="#C22530" Height="33"/></StackPanel>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Stretch"><StackPanel Width="250">
<TextBlock Text="{DynamicResource Text.Machine.Control}" Foreground="#E8F0F5" FontWeight="SemiBold" Margin="4,1,0,6"/>
<Border Background="#101D27" Padding="10,6" Margin="3,0,3,5"><StackPanel><DockPanel><TextBlock Text="X" Width="24" Foreground="#FFBF4D" FontFamily="Consolas" FontSize="17"/><TextBlock Text="{Binding Machine.X, StringFormat={}{0:F3} mm}" Foreground="#F1F6F8" FontFamily="Consolas" FontSize="17" HorizontalAlignment="Right"/></DockPanel><DockPanel><TextBlock Text="Y" Width="24" Foreground="#FFBF4D" FontFamily="Consolas" FontSize="17"/><TextBlock Text="{Binding Machine.Y, StringFormat={}{0:F3} mm}" Foreground="#F1F6F8" FontFamily="Consolas" FontSize="17" HorizontalAlignment="Right"/></DockPanel><DockPanel><TextBlock Text="Z" Width="24" Foreground="#FFBF4D" FontFamily="Consolas" FontSize="17"/><TextBlock Text="{Binding Machine.Z, StringFormat={}{0:F3} mm}" Foreground="#F1F6F8" FontFamily="Consolas" FontSize="17" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border><Button Command="{Binding ShutterCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.ShutterOpen}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M3,3 L21,21 M12,2 A10,10 0 1 1 11.9,2 M7,12 L17,12" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Shutter}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><UniformGrid Columns="2"><Button Command="{Binding RedLightCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.RedLightOn}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M12,1 L12,23 M1,12 L23,12 M12,5 A7,7 0 1 1 11.9,5" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.RedLight}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Command="{Binding EmitCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.LaserOn}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12 M5,5 L8,8 M16,16 L19,19 M5,19 L8,16 M16,8 L19,5 M12,9 A3,3 0 1 1 11.9,9" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Emit}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Command="{Binding FollowCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.FollowEnabled}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M5,3 L13,3 13,12 5,12 Z M9,14 L9,22 M5,18 L9,22 13,18 M18,3 L18,15 M15,6 L18,3 21,6" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Follow}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Command="{Binding AirCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.AirOn}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M5,2 L19,2 15,8 9,8 Z M12,10 L12,22 M9,10 L5,21 M15,10 L19,21" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Air}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Command="{Binding HomeCommand}" Style="{StaticResource Tile}"><StackPanel><Path Data="M2,12 L12,3 22,12 M6,10 L6,21 18,21 18,10" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Home}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Command="{Binding FrameCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Tile}"><Style.Triggers><DataTrigger Binding="{Binding Machine.IsFraming}" Value="True"><Setter Property="Background" Value="#855B12"/><Setter Property="BorderBrush" Value="#FFBF4D"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="M8,3 L3,3 3,9 M16,3 L21,3 21,9 M3,15 L3,21 9,21 M15,21 L21,21 21,15 M8,12 L16,12 M13,9 L16,12 13,15" Stroke="#FFBF4D" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Frame}" Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button></UniformGrid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><views:JogWheel Width="146" Height="146" IsEnabled="{Binding Machine.CanJog}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Z ↑" Tag="+" Style="{StaticResource Tile}" Height="55" FontSize="21" IsEnabled="{Binding Machine.CanZJog}" PreviewMouseLeftButtonDown="ZDown" PreviewMouseLeftButtonUp="ZUp" MouseLeave="ZLeave" LostMouseCapture="ZLeave" IsEnabledChanged="ZDisabled" PreviewKeyDown="ZKey"/><Button Content="Z ↓" Tag="-" Style="{StaticResource Tile}" Height="55" FontSize="21" IsEnabled="{Binding Machine.CanZJog}" PreviewMouseLeftButtonDown="ZDown" PreviewMouseLeftButtonUp="ZUp" MouseLeave="ZLeave" LostMouseCapture="ZLeave" IsEnabledChanged="ZDisabled" PreviewKeyDown="ZKey"/></StackPanel></Grid><TextBlock Text="{DynamicResource Text.Machine.ConsoleHint}" TextWrapping="Wrap" Foreground="#B7CAD7" FontSize="10" Margin="5,0,5,4"/>
<DockPanel Margin="5,5"><TextBlock Text="{DynamicResource Text.Machine.Speed}" Width="180" Foreground="#D8E5EF" FontSize="11"/><TextBlock Text="{Binding Machine.JogOverride, StringFormat={}{0:0}%}" Foreground="#FFBF4D" HorizontalAlignment="Right" FontFamily="Consolas"/></DockPanel><Slider Minimum="10" Maximum="100" Value="{Binding Machine.JogOverride}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="7,0,7,8"/>
<DockPanel Margin="5,0,5,8"><TextBlock Text="{DynamicResource Text.Machine.LivePower}" Width="180" Foreground="#D8E5EF" FontSize="11"/><TextBlock Text="{Binding Machine.CurrentPowerPercent, StringFormat={}{0:F1} %}" Foreground="#FFBF4D" FontFamily="Consolas" HorizontalAlignment="Right"/></DockPanel>
</StackPanel></Viewbox></DockPanel></Border></UserControl>