<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <TextBlock Text="{DynamicResource Text.Machine.NavLogs}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
 <DataGrid Grid.Row="1" ItemsSource="{Binding Operation.Machine.Events}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="34" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" RowBackground="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
 <DataGrid.Columns><DataGridTextColumn Binding="{Binding Time}" Width="95"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Text.Machine.Time}"/></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn><DataGridTextColumn Binding="{Binding Level}" Width="85"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Text.Machine.Level}"/></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn><DataGridTextColumn Binding="{Binding Message}" Width="*"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Text.Machine.Message}"/></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn></DataGrid.Columns>
 <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="ALARM"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
 </DataGrid>
</Grid>
