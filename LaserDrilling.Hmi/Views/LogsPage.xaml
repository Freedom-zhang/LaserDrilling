<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="20">
    <Grid.Resources>
        <Style x:Key="LogHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <DataGridCellsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075A88" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#FFBF4D" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right">
            <TextBlock
                HorizontalAlignment="Right"
                FontFamily="Consolas"
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding Operation.Machine.Events.Count}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource MutedBrush}"
                Text="{DynamicResource Text.Machine.LogSessionHint}" />
        </StackPanel>
        <TextBlock
            VerticalAlignment="Center"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{DynamicResource Text.Machine.NavLogs}" />
    </DockPanel>
    <DataGrid
        x:Name="LogTable"
        Grid.Row="1"
        AlternationCount="2"
        AutoGenerateColumns="False"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource LineBrush}"
        BorderThickness="1"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        CellStyle="{StaticResource LogCell}"
        ColumnHeaderStyle="{StaticResource LogHeader}"
        EnableRowVirtualization="True"
        FontSize="13"
        Foreground="{DynamicResource InkBrush}"
        GridLinesVisibility="None"
        HeadersVisibility="Column"
        IsReadOnly="True"
        ItemsSource="{Binding Operation.Machine.Events}"
        RowHeight="42"
        RowStyle="{StaticResource LogRow}"
        SelectionMode="Single"
        SelectionUnit="FullRow">
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="105"
                Binding="{Binding Time}"
                ElementStyle="{StaticResource LogText}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource Text.Machine.Time}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTemplateColumn Width="110" SortMemberPath="Level">
                <DataGridTemplateColumn.Header>
                    <TextBlock Text="{DynamicResource Text.Machine.Level}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Border
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#236185" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                            <Setter Property="Background" Value="#885600" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="ALARM">
                                            <Setter Property="Background" Value="#B52635" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Level}" />
                        </Border>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
                Width="*"
                Binding="{Binding Message}"
                ElementStyle="{StaticResource LogText}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource Text.Machine.Message}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
        </DataGrid.Columns>
    </DataGrid>
    <TextBlock
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource MutedBrush}"
        IsHitTestVisible="False"
        Text="{DynamicResource Text.Machine.LogEmpty}">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Operation.Machine.Events.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
    <Border
        Grid.Row="2"
        Margin="0,10,0,0"
        Padding="12"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource LineBrush}"
        BorderThickness="1">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Text="{DynamicResource Text.Machine.LogDetail}" />
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    MinHeight="22"
                    Foreground="{DynamicResource InkBrush}"
                    Text="{Binding SelectedItem.Message, ElementName=LogTable}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</Grid>
