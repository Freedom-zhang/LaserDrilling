<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" Margin="24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="{DynamicResource Text.Machine.NavDevice}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text.Machine.Mock}" Margin="0,8,0,20" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="24"><StackPanel>
  <hc:Tag DataContext="{Binding Machine}" Content="{Binding StateText}" Style="{StaticResource MotionStateTag}" FontSize="20" Margin="0,0,0,24"/>
  <UniformGrid Columns="2" Rows="5" Height="180"><TextBlock Text="{DynamicResource Text.Machine.Laser}"/><TextBlock Text="{Binding Machine.LaserText}"/><TextBlock Text="{DynamicResource Text.Machine.Air}"/><TextBlock Text="{Binding Machine.AirText}"/><TextBlock Text="{DynamicResource Text.Machine.Motion}"/><TextBlock Text="{Binding Machine.ReferenceText}"/><TextBlock Text="{DynamicResource Text.Machine.Door}"/><TextBlock Text="{Binding Machine.DoorText}"/><TextBlock Text="{DynamicResource Text.Machine.Cooling}"/><TextBlock Text="{Binding Machine.Simulation.ChillerCelsius, StringFormat={}{0:F1} °C / MOCK}"/></UniformGrid>
  <Separator Margin="0,20"/><TextBlock Text="{Binding Machine.ModeText}" FontWeight="SemiBold"/>
 </StackPanel></Border>
 <UniformGrid Grid.Row="2" Columns="3" Margin="0,20,0,0"><Button Content="{DynamicResource Text.Machine.DoorTest}" Command="{Binding DoorCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="{DynamicResource Text.Machine.Reset}" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="{DynamicResource Text.Machine.Emergency}" Command="{Binding EmergencyCommand}" Style="{StaticResource PrimaryButton}" Background="#AC3539"/></UniformGrid>
</Grid>
