<UserControl x:Class="LaserDrilling.Hmi.Views.WelcomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" Loaded="OnLoaded">
 <Grid Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel>
 <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="24,0,0,0"/>
 <TextBlock DockPanel.Dock="Right" Text="{Binding UserName}" VerticalAlignment="Center" Margin="24,0"/>
 <Border DockPanel.Dock="Right" Background="#FFF0D6" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.Machine.Mock}" Foreground="#75521B" FontSize="11"/></Border>
 <Image DockPanel.Dock="Left" Source="{StaticResource CompanyLogo}" Width="38" Height="38" Margin="0,0,14,0"/>
 <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.Product}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="XX LASER / PRECISION DRILLING" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 </DockPanel></Border>
 <Border Grid.Row="1" Background="#172B38"><DockPanel>

 <Button DockPanel.Dock="Bottom" Command="{Binding SignOutCommand}" Style="{StaticResource HmiNavButton}" Height="70"><StackPanel><Path Data="{StaticResource Icon.Logout}" Style="{StaticResource HmiIcon}" Height="19"/><TextBlock Text="{DynamicResource Text.SignOut}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
 <StackPanel><Button Command="{Binding DeviceCommand}" Style="{StaticResource HmiNavButton}"><StackPanel><Path Data="{StaticResource Icon.Device}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavDevice}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
<Button Command="{Binding OperationCommand}" Style="{StaticResource HmiNavButton}" Background="#294957" BorderBrush="#59C5D0" Foreground="White"><StackPanel><Path Data="{StaticResource Icon.Workspace}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavWorkspace}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
<Button Command="{Binding RecipeCommand}" Style="{StaticResource HmiNavButton}"><StackPanel><Path Data="{StaticResource Icon.Recipe}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavRecipes}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
<Button Command="{Binding LogsCommand}" Style="{StaticResource HmiNavButton}"><StackPanel><Path Data="{StaticResource Icon.Alarm}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavLogs}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
<Button Command="{Binding SettingsCommand}" Style="{StaticResource HmiNavButton}"><StackPanel><Path Data="{StaticResource Icon.Settings}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavSettings}" Style="{StaticResource HmiNavText}"/></StackPanel></Button>
</StackPanel></DockPanel></Border>
 <Grid Grid.Row="1" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,7"><UniformGrid Columns="3">
 <StackPanel><TextBlock Text="{DynamicResource Text.Machine.ConnectionStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Operation.Machine.ConnectionText}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
 <StackPanel><TextBlock Text="{DynamicResource Text.Machine.LaserStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Operation.Machine.LaserText}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
 <StackPanel><TextBlock Text="{DynamicResource Text.Machine.MotionStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Operation.Machine.MotionText}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
 </UniformGrid></Border><views:DrillingView Grid.Row="1" DataContext="{Binding Operation}"/>
 <TextBlock Grid.Row="2" Text="{DynamicResource Text.Machine.Footer}" Margin="10,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
 </Grid></Grid></UserControl>