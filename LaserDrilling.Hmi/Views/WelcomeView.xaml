<UserControl x:Class="LaserDrilling.Hmi.Views.WelcomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:views="clr-namespace:LaserDrilling.Hmi.Views" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" Loaded="OnLoaded">
<Grid Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/><RowDefinition Height="25"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition/><ColumnDefinition Width="274"/></Grid.ColumnDefinitions>
<Border Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="660"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource CompanyLogo}" Width="42" Height="42" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.Product}" Width="350" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="XX LASER / PRECISION DRILLING" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></StackPanel>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{DynamicResource Text.Machine.Mock}" Width="230" TextAlignment="Right" Foreground="#B27512" FontWeight="Bold" Margin="0,0,20,0"/><TextBlock Text="{Binding UserName}" Margin="0,0,20,0"/><TextBlock Text="{Binding ClockText}" FontFamily="Consolas" FontSize="14"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="3" DataContext="{Binding Operation.Machine}"><StackPanel Margin="5,0,0,0"><TextBlock Text="{DynamicResource Text.Machine.ConnectionStatus}" FontSize="10" Margin="4,0,0,2"/><hc:Tag Content="{Binding ConnectionText}" Style="{StaticResource HmiStateTag}" FontSize="11"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="{DynamicResource Text.Machine.LaserStatus}" FontSize="10" Margin="4,0,0,2"/><hc:Tag Content="{Binding LaserText}" Style="{StaticResource LaserStateTag}" FontSize="11"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="{DynamicResource Text.Machine.MotionStatus}" FontSize="10" Margin="4,0,0,2"/><hc:Tag Content="{Binding MotionText}" Style="{StaticResource MotionStateTag}" FontSize="11"/></StackPanel></UniformGrid></Grid></Grid></Border><Border Grid.Row="1" Background="#172B38"><DockPanel><Button DockPanel.Dock="Bottom" Command="{Binding SignOutCommand}" Style="{StaticResource HmiNavButton}" Height="62"><StackPanel><Path Data="{StaticResource Icon.Logout}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.SignOut}" Style="{StaticResource HmiNavText}"/></StackPanel></Button><StackPanel><Button Command="{Binding DeviceCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HmiNavButton}"><Setter Property="Height" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Device"><Setter Property="Background" Value="#294957"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFBA38"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="{StaticResource Icon.Device}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavDevice}" Style="{StaticResource HmiNavText}"/></StackPanel></Button><Button Command="{Binding OperationCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HmiNavButton}"><Setter Property="Height" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Workspace"><Setter Property="Background" Value="#294957"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFBA38"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="{StaticResource Icon.Workspace}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavWorkspace}" Style="{StaticResource HmiNavText}"/></StackPanel></Button><Button Command="{Binding RecipeCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HmiNavButton}"><Setter Property="Height" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Recipes"><Setter Property="Background" Value="#294957"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFBA38"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="{StaticResource Icon.Recipe}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavRecipes}" Style="{StaticResource HmiNavText}"/></StackPanel></Button><Button Command="{Binding LogsCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HmiNavButton}"><Setter Property="Height" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Logs"><Setter Property="Background" Value="#294957"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFBA38"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><hc:Badge Status="Dot" HorizontalAlignment="Center"><hc:Badge.Style><Style TargetType="hc:Badge" BasedOn="{StaticResource BadgeDanger}"><Setter Property="ShowBadge" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding Operation.Machine.State}" Value="Fault"><Setter Property="ShowBadge" Value="True"/></DataTrigger></Style.Triggers></Style></hc:Badge.Style><Path Data="{StaticResource Icon.Alarm}" Style="{StaticResource HmiIcon}"/></hc:Badge><TextBlock Text="{DynamicResource Text.Machine.NavLogs}" Style="{StaticResource HmiNavText}"/></StackPanel></Button><Button Command="{Binding SettingsCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HmiNavButton}"><Setter Property="Height" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Settings"><Setter Property="Background" Value="#294957"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFBA38"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Path Data="{StaticResource Icon.Settings}" Style="{StaticResource HmiIcon}"/><TextBlock Text="{DynamicResource Text.Machine.NavSettings}" Style="{StaticResource HmiNavText}"/></StackPanel></Button></StackPanel></DockPanel></Border>
<views:WorkspaceContentHost Grid.Row="1" Grid.Column="1" SelectedPage="{Binding SelectedPage}"/>
<views:ControlConsole Grid.Row="1" Grid.Column="2" DataContext="{Binding Operation}"/>
<Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource SubtleBrush}" Padding="12,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Operation.Machine.ModeText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Text.Machine.Footer}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
  <Border Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Operation}" Background="#990E1A24">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasConfirmation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#D6A34A" BorderThickness="0,4,0,0" Width="460" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="{DynamicResource Text.Machine.ConfirmTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Margin="0,18,0,24" FontSize="14"/><UniformGrid Columns="2"><Button Content="{DynamicResource Text.Machine.Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,2,0"/><Button Content="{DynamicResource Text.Machine.Confirm}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}"/></UniformGrid></StackPanel>
   </Border>
  </Border>
</Grid></UserControl>