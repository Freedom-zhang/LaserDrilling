<UserControl
    x:Class="LaserDrilling.Hmi.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:LaserDrilling.Hmi.Views"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Loaded="OnLoaded"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition />
            <ColumnDefinition Width="274" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.ColumnSpan="3"
            Margin="0,0,0,16"
            Padding="18,6"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0">
            <DockPanel>
                <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding DateText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding TimeText}" />
                </StackPanel>
                <TextBlock
                    Margin="0,0,28,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="14"
                    Text="{Binding UserName}" />
                <Image
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Left"
                    Source="{StaticResource CompanyLogo}" />
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#172B38">
            <DockPanel>
                <Button
                    Height="62"
                    Command="{Binding SignOutCommand}"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource HmiNavButton}">
                    <StackPanel>
                        <Path Data="{StaticResource Icon.Logout}" Style="{StaticResource HmiIcon}" />
                        <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.SignOut}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <Button Command="{Binding DeviceCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Device">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Device}" Style="{StaticResource HmiIcon}" />
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavDevice}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OperationCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Workspace">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Workspace}" Style="{StaticResource HmiIcon}" />
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavWorkspace}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RecipeCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Recipes">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Recipe}" Style="{StaticResource HmiIcon}" />
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavRecipes}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LogsCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Logs">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <hc:Badge HorizontalAlignment="Center" Status="Dot">
                                <hc:Badge.Style>
                                    <Style BasedOn="{StaticResource BadgeDanger}" TargetType="hc:Badge">
                                        <Setter Property="ShowBadge" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Operation.Machine.State}" Value="Fault">
                                                <Setter Property="ShowBadge" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:Badge.Style>
                                <Path Data="{StaticResource Icon.Alarm}" Style="{StaticResource HmiIcon}" />
                            </hc:Badge>
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavLogs}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MaintenanceCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Maintenance">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Recipe}" Style="{StaticResource HmiIcon}" />
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavMaintenance}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SettingsCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HmiNavButton}" TargetType="Button">
                                <Setter Property="Height" Value="72" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Settings">
                                        <Setter Property="Background" Value="#294957" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FFBA38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource HmiIcon}" />
                            <TextBlock Style="{StaticResource HmiNavText}" Text="{DynamicResource Text.Machine.NavSettings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- One continuous background prevents fractional-DPI seams at the console junction. -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                Background="{DynamicResource ConsoleBackgroundBrush}" BorderThickness="0" />
        <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource PageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>
            <views:WorkspaceContentHost SelectedPage="{Binding SelectedPage}">
                <views:WorkspaceContentHost.Style>
                    <Style TargetType="views:WorkspaceContentHost">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="Workspace">
                                <Setter Property="Margin" Value="0,0,0,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:WorkspaceContentHost.Style>
            </views:WorkspaceContentHost>
            <Border
                Grid.Row="1"
                Padding="8,6"
                Background="{DynamicResource ConsoleBackgroundBrush}"
                BorderBrush="{DynamicResource ConsoleBorderBrush}"
                BorderThickness="0">
                <Grid DataContext="{Binding Operation.Machine}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource ConsoleForegroundBrush}"
                            Text="{DynamicResource Text.Machine.ConnectionStatus}"
                            TextWrapping="Wrap" />
                        <hc:Tag
                            Grid.Column="1"
                            Height="44"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{Binding ConnectionText}"
                            FontSize="12"
                            Style="{StaticResource HmiStateTag}"
                            ToolTip="{Binding ConnectionText}">
                            <hc:Tag.ContentTemplate>
                                <DataTemplate>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{Binding}" />
                                    </Viewbox>
                                </DataTemplate>
                            </hc:Tag.ContentTemplate>
                        </hc:Tag>
                    </Grid>
                    <Grid Grid.Column="1" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource ConsoleForegroundBrush}"
                            Text="{DynamicResource Text.Machine.LaserStatus}"
                            TextWrapping="Wrap" />
                        <hc:Tag
                            Grid.Column="1"
                            Height="44"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{Binding LaserText}"
                            FontSize="12"
                            Style="{StaticResource LaserStateTag}"
                            ToolTip="{Binding LaserText}">
                            <hc:Tag.ContentTemplate>
                                <DataTemplate>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{Binding}" />
                                    </Viewbox>
                                </DataTemplate>
                            </hc:Tag.ContentTemplate>
                        </hc:Tag>
                    </Grid>
                    <Grid Grid.Column="2" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource ConsoleForegroundBrush}"
                            Text="{DynamicResource Text.Machine.MotionStatus}"
                            TextWrapping="Wrap" />
                        <hc:Tag
                            Grid.Column="1"
                            Height="44"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{Binding MotionText}"
                            FontSize="12"
                            Style="{StaticResource MotionStateTag}"
                            ToolTip="{Binding MotionText}">
                            <hc:Tag.ContentTemplate>
                                <DataTemplate>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{Binding}" />
                                    </Viewbox>
                                </DataTemplate>
                            </hc:Tag.ContentTemplate>
                        </hc:Tag>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <views:ControlConsole
            IsEnabled="{Binding DataContext.IsConsoleEnabled, RelativeSource={RelativeSource AncestorType=views:WelcomeView}}"
            Grid.Row="1"
            Grid.Column="2"
            DataContext="{Binding Operation}" />

        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="#990E1A24"
            DataContext="{Binding Operation}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConfirmation}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border
                Width="460"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="#D6A34A"
                BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Text.Machine.ConfirmTitle}" />
                    <TextBlock
                        Margin="0,18,0,24"
                        FontSize="14"
                        Text="{Binding Confirmation}"
                        TextWrapping="Wrap" />
                    <UniformGrid Columns="2">
                        <Button
                            Margin="0,0,2,0"
                            Command="{Binding CancelCommand}"
                            Content="{DynamicResource Text.Machine.Cancel}"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Command="{Binding ConfirmCommand}"
                            Content="{DynamicResource Text.Machine.Confirm}"
                            Style="{StaticResource PrimaryButton}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>